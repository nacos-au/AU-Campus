{
  "name": "au-campus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n campus,digest,score -c cyan,magenta,green \"npm run dev:campus\" \"npm run dev:digest\" \"npm run dev:score\"",
    "dev:campus": "npm run dev -w @au/campus",
    "dev:digest": "npm run dev -w @au/digest",
    "dev:score": "npm run dev -w @au/score",
    "build": "npm run build -w @au/campus && npm run build -w @au/digest && npm run build -w @au/score",
    "build:campus": "npm run build -w @au/campus",
    "build:digest": "npm run build -w @au/digest",
    "build:score": "npm run build -w @au/score",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:seed:score": "npm run db:seed -w @au/score"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supabase": "^2.72.7"
  }
}
