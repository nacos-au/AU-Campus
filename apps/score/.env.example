# AU Score — set these on Vercel project `au-score` (Production + Preview).

# Required — shared Digest/Score Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for seed scripts / admin bypass locally (optional on Vercel unless you run seeds there)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=https://score.YOUR_DOMAIN
NEXT_PUBLIC_DIGEST_URL=https://digest.YOUR_DOMAIN
NEXT_PUBLIC_CAMPUS_URL=https://YOUR_DOMAIN

# Live mode (recommended on Production): omit DEMO_MODE or set false
# DEMO_MODE=false

# Only for forced demo theatre without Supabase:
# DEMO_MODE=true
