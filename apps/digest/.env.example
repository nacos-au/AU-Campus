# ── Supabase ──────────────────────────────────────────────────────────────
# Hosted: find these in Project Settings → API.
# Local (Docker): printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack ──────────────────────────────────────────────────────────────
# Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────
# Public origin of this deployment (used for Paystack callback URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to preview the public site with built-in fixture content and
# no database (auth, CMS and payments are disabled). On Vercel, if this is
# unset and Supabase keys are missing, demo mode turns on automatically so
# the site doesn't 500. Set DEMO_MODE=false once real Supabase keys are set.
DEMO_MODE=true
