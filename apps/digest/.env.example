# ── Supabase ──────────────────────────────────────────────────────────────
# Hosted: find these in Project Settings → API.
# Local (Docker): printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OUT OF SCOPE — timed release cron (see docs/OUT_OF_SCOPE.md).
# Parked posts go live only when an editor clicks Make live.
# CRON_SECRET=generate-a-long-random-string

# ── Paystack ──────────────────────────────────────────────────────────────
# Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────
# Public origin of this deployment (used for Paystack callback URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CAMPUS_URL=http://localhost:3000
NEXT_PUBLIC_SCORE_URL=http://localhost:3002

# Set to "true" to preview fixtures with no database. With real Supabase keys
# on Vercel, set DEMO_MODE=false (or leave unset) and use the Live toggle only
# when you need fixtures. Auth always uses the live project when keys exist.
DEMO_MODE=false
